# Copy this file to ".env" and fill in your LLM API key.
# The key stays on the SERVER only — it is never sent to the app.
LLM_API_KEY=sk-your-key-here

# Optional overrides (OpenAI-compatible endpoints work here)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Port the coach API listens on (frontend defaults to 4000)
PORT=4000
